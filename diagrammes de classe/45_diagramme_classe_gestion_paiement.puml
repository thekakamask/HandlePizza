@startuml
left to right direction
skinparam classAttributeIconSize 0
title HandlePizza - Diagramme gestion du paiement

class "command" as Command {
  +id_command : Long
  +payment_amount : Float
  +payment_method : payment_method
  +payment_status : payment_status
  +command_status : command_status
}

class "customer" as Customer {
  +id_customer : Long
}

class "employe" as Employe {
  +id_employe : Long
  +fonction : String
}

class "delivery_man" as DeliveryMan
class "sales_point" as SalesPoint {
  +id_sales_point : Long
  +name : String
  +is_open : Boolean
}

enum "payment_method" as PaymentMethod {
  money
  paypal
  credit_card
}

enum "payment_status" as PaymentStatus {
  in_progress
  cancelled
  validate
}

enum "command_status" as CommandStatus {
  confirmed
  in_preparation
  in_delivery
  delivered
  cancelled
}

' Aligné au diagramme global validé
Employe <|-- DeliveryMan

Customer "1" -- "0..*" Command
Employe "1" -- "0..*" Command
SalesPoint "1" o-- "0..*" Command

Command "*" -- "1" PaymentMethod : utilise
Command "*" -- "1" PaymentStatus : etat_paiement
Command "*" -- "1" CommandStatus : etat_commande

@enduml
